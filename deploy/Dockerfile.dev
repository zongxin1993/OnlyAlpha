FROM ghcr.io/astral-sh/uv:0.10.5@sha256:476133fa2aaddb4cbee003e3dc79a88d327a5dc7cb3179b7f02cabd8fdfbcc6e AS uv

FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_LINK_MODE=copy

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl gnupg \
    && install -d -m 0755 /usr/share/postgresql-common/pgdg \
    && curl --fail --silent --show-error https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor --yes -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        libpq5=18.6-1.pgdg12+2 \
        postgresql-client-common=293.pgdg12+1 \
        postgresql-client-18=18.6-1.pgdg12+2 \
    && apt-get purge --yes --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/

RUN useradd --create-home --uid 10001 onlyalpha \
    && install -d -o onlyalpha -g onlyalpha /workspace /var/lib/onlyalpha /var/lib/onlyalpha-agent /var/run/onlyalpha-agent
WORKDIR /workspace
COPY --chown=onlyalpha:onlyalpha . .
USER onlyalpha

ARG ONLYALPHA_BUILD_SOURCE_REVISION=0000000000000000000000000000000000000000
RUN python scripts/embed_build_provenance.py --revision "${ONLYALPHA_BUILD_SOURCE_REVISION}" \
    && python packages/onlyalpha-agent-orchestrator/provenance_build.py \
        --revision "${ONLYALPHA_BUILD_SOURCE_REVISION}"

RUN uv sync --frozen --all-packages --no-dev

ENV PATH="/workspace/.venv/bin:${PATH}" \
    ONLYALPHA_POSTGRES_CLIENT_BIN_DIR=/usr/lib/postgresql/18/bin \
    UV_NO_SYNC=1

FROM runtime AS test
USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git postgresql-18=18.6-1.pgdg12+2 \
    && rm -rf /var/lib/apt/lists/*
USER onlyalpha
RUN git config --global --add safe.directory /workspace
RUN uv sync --frozen --all-packages --no-dev --group compose-acceptance
USER root
RUN rm -f \
    /workspace/src/onlyalpha/_build_provenance.json \
    /workspace/src/onlyalpha/_build_provenance.sha256 \
    /workspace/packages/onlyalpha-agent-orchestrator/src/onlyalpha_agent_orchestrator/_build_provenance.json \
    /workspace/packages/onlyalpha-agent-orchestrator/src/onlyalpha_agent_orchestrator/_build_provenance.sha256
USER onlyalpha

FROM node:24-bookworm-slim AS web
WORKDIR /workspace/packages/onlyalpha-web-console
COPY packages/onlyalpha-web-console/package.json packages/onlyalpha-web-console/package-lock.json ./
RUN npm ci
COPY packages/onlyalpha-web-console/ ./
COPY test-data/web/catalog-navigation/ /workspace/test-data/web/catalog-navigation/
EXPOSE 5173

FROM web AS playwright
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx playwright install --with-deps chromium

# Owner-authorized opt-in loopback Browser/API acceptance, same canonical test service.
# The default Python test and all production targets remain unchanged.
FROM test AS browser-test
USER root
COPY --from=web /usr/local/bin/node /usr/local/bin/node
COPY --from=web /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=web --chown=onlyalpha:onlyalpha /workspace/packages/onlyalpha-web-console/node_modules /workspace/packages/onlyalpha-web-console/node_modules
COPY --from=playwright /ms-playwright /ms-playwright
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && node packages/onlyalpha-web-console/node_modules/playwright/cli.js install-deps chromium
# Source-only edits reuse this tool image; changed build/dependency inputs require
# an explicit rebuild, not an implicit uv/npm update in the validation container.
RUN mkdir -p /workspace/packages/onlyalpha-web-console/node_modules/.vite \
    /workspace/packages/onlyalpha-web-console/node_modules/.vite-temp
RUN python -c "import json; from pathlib import Path; from scripts.dev_verification import environment_inputs; Path('/opt/onlyalpha-dev-environment.json').write_text(json.dumps(environment_inputs(Path('/workspace')), sort_keys=True))"
USER onlyalpha
