FROM ghcr.io/astral-sh/uv:0.10.5@sha256:476133fa2aaddb4cbee003e3dc79a88d327a5dc7cb3179b7f02cabd8fdfbcc6e AS uv

# Official Rust toolchain is a build/validation input, never a production service.
FROM rust:1.99.1-slim-bookworm@sha256:a24e292b4af7bdee351a31d3a6379972a5652f0ea22a1b6d6883324ac4f5097c AS rust-tools
RUN rustup component add --toolchain 1.99.1 rustfmt clippy

# Dependency resolution is an explicit preparation artifact, never a test lane.
FROM rust-tools AS rust-manifests
WORKDIR /rust-source
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ ./crates/
COPY packages/backend/ ./packages/backend/
COPY plugs/onlyalpha-plugin-binance/Cargo.toml ./plugs/onlyalpha-plugin-binance/Cargo.toml
COPY plugs/onlyalpha-plugin-binance/rust/ ./plugs/onlyalpha-plugin-binance/rust/
COPY plugs/onlyalpha-plugin-tushare/Cargo.toml ./plugs/onlyalpha-plugin-tushare/Cargo.toml
COPY plugs/onlyalpha-plugin-tushare/rust/ ./plugs/onlyalpha-plugin-tushare/rust/

FROM rust-manifests AS rust-dependency-resolution
RUN CARGO_NET_RETRY=0 cargo update --workspace

FROM scratch AS rust-lockfile
COPY --from=rust-dependency-resolution /rust-source/Cargo.lock /Cargo.lock

FROM rust-manifests AS rust-dependencies
RUN CARGO_NET_RETRY=0 cargo fetch --locked

FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c AS reference-tools

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_LINK_MODE=copy

RUN test -s /etc/ssl/certs/ca-certificates.crt \
    && sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl gnupg \
    && install -d -m 0755 /usr/share/postgresql-common/pgdg \
    && curl --fail --silent --show-error https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor --yes -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        libpq5=18.6-1.pgdg12+2 \
        postgresql-client-common=293.pgdg12+1 \
        postgresql-client-18=18.6-1.pgdg12+2 \
    && apt-get purge --yes --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/

RUN useradd --create-home --uid 10001 onlyalpha \
    && install -d -o onlyalpha -g onlyalpha /workspace /var/lib/onlyalpha /var/lib/onlyalpha-agent /var/run/onlyalpha-agent
WORKDIR /workspace
COPY --chown=onlyalpha:onlyalpha . .
USER onlyalpha

ARG ONLYALPHA_BUILD_SOURCE_REVISION=0000000000000000000000000000000000000000
RUN python scripts/embed_build_provenance.py --revision "${ONLYALPHA_BUILD_SOURCE_REVISION}" \
    && python packages/onlyalpha-agent-orchestrator/provenance_build.py \
        --revision "${ONLYALPHA_BUILD_SOURCE_REVISION}"

RUN uv sync --frozen --all-packages --no-dev

ENV PATH="/workspace/.venv/bin:${PATH}" \
    ONLYALPHA_POSTGRES_CLIENT_BIN_DIR=/usr/lib/postgresql/18/bin \
    UV_NO_SYNC=1

FROM reference-tools AS test
USER root
COPY --from=rust-tools /usr/local/rustup /usr/local/rustup
COPY --from=rust-tools /usr/local/cargo /usr/local/cargo
COPY --from=rust-dependencies /usr/local/cargo/registry /usr/local/cargo/registry
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/tmp/onlyalpha-cargo \
    RUSTUP_AUTO_INSTALL=0 \
    PATH="/usr/local/cargo/bin:${PATH}"
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git gcc libc6-dev postgresql-18=18.6-1.pgdg12+2 \
    && rm -rf /var/lib/apt/lists/*
USER onlyalpha
RUN git config --global --add safe.directory /workspace
RUN uv sync --frozen --all-packages --no-dev --group compose-acceptance
# Prepare the exact existing contract tool while builds have network access;
# the isolated validation service executes only cached tools, offline.
RUN python - <<'PY_CONTRACT_TOOLS'
import subprocess
import tomllib
from pathlib import Path

mypy = next(package["version"] for package in tomllib.loads(Path("uv.lock").read_text())["package"] if package["name"] == "mypy")
subprocess.run(["uvx", "--from", "schemathesis==4.26.1", "schemathesis", "--version"], check=True)
subprocess.run(["uvx", "--from", "schemathesis==4.26.1", "--with", "mypy==" + mypy, "mypy", "--version"], check=True)
PY_CONTRACT_TOOLS
USER root
RUN rm -f \
    /workspace/src/onlyalpha/_build_provenance.json \
    /workspace/src/onlyalpha/_build_provenance.sha256 \
    /workspace/packages/onlyalpha-agent-orchestrator/src/onlyalpha_agent_orchestrator/_build_provenance.json \
    /workspace/packages/onlyalpha-agent-orchestrator/src/onlyalpha_agent_orchestrator/_build_provenance.sha256
USER onlyalpha

FROM node:24-bookworm-slim AS web
WORKDIR /workspace/packages/frontend
COPY packages/frontend/package.json packages/frontend/package-lock.json ./
RUN npm ci
COPY packages/frontend/ ./
COPY test-data/web/catalog-navigation/ /workspace/test-data/web/catalog-navigation/
COPY test-data/web/chart-studies/ /workspace/test-data/web/chart-studies/
EXPOSE 5173

FROM web AS playwright
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY --from=reference-tools /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && npx playwright install --with-deps chromium

# Owner-authorized opt-in loopback Browser/API acceptance, same canonical test service.
# Broad Python reference dependencies belong only to verification tools.
FROM test AS browser-test
USER root
COPY --from=web /usr/local/bin/node /usr/local/bin/node
COPY --from=web /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=web --chown=onlyalpha:onlyalpha /workspace/packages/frontend/node_modules /workspace/packages/frontend/node_modules
COPY --from=playwright /ms-playwright /ms-playwright
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && node packages/frontend/node_modules/playwright/cli.js install-deps chromium
# Source-only edits reuse this tool image; changed build/dependency inputs require
# an explicit rebuild, not an implicit uv/npm update in the validation container.
RUN mkdir -p /workspace/packages/frontend/node_modules/.vite \
    /workspace/packages/frontend/node_modules/.vite-temp
RUN python -c "import json; from pathlib import Path; from scripts.dev_verification import environment_inputs; Path('/opt/onlyalpha-dev-environment.json').write_text(json.dumps(environment_inputs(Path('/workspace')), sort_keys=True))"
USER onlyalpha

# The maintained backend artifact; no Python service or business module is copied.
FROM rust-dependencies AS native-service
RUN cargo build --locked --offline --release --package onlyalpha-backend --bin onlyalpha-backend

FROM web AS web-assets
RUN NODE_ENV=production VITE_ONLYALPHA_LOCAL_SESSION=true npm run build

# Reuse the admitted exact algorithm installation rather than a broad Core wheel.
FROM reference-tools AS algorithm-installation
USER root
RUN install -d -o onlyalpha -g onlyalpha /opt/onlyalpha
USER onlyalpha
RUN python scripts/build_algorithm_sdk.py /opt/onlyalpha/wheels --install /opt/onlyalpha/algorithms \
    > /opt/onlyalpha/algorithm-artifact.sha256

FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ONLYALPHA_NATIVE_ALGORITHMS=/opt/onlyalpha/algorithms \
    ONLYALPHA_NATIVE_ALGORITHM_ARTIFACT_FILE=/opt/onlyalpha/algorithm-artifact.sha256 \
    ONLYALPHA_NATIVE_SCHEMA=/opt/onlyalpha/schema \
    ONLYALPHA_NATIVE_WEB_ASSETS=/opt/onlyalpha/web \
    ONLYALPHA_NATIVE_SOURCE_TRUST=/etc/ssl/certs/ca-certificates.crt
RUN useradd --create-home --uid 10001 onlyalpha \
    && install -d -o onlyalpha -g onlyalpha /var/lib/onlyalpha
COPY --from=native-service /rust-source/target/release/onlyalpha-backend /usr/local/bin/onlyalpha-backend
COPY --from=algorithm-installation /opt/onlyalpha/algorithms /opt/onlyalpha/algorithms
COPY --from=algorithm-installation /opt/onlyalpha/algorithm-artifact.sha256 /opt/onlyalpha/algorithm-artifact.sha256
COPY --from=algorithm-installation /opt/onlyalpha/wheels /opt/onlyalpha/wheels
COPY --from=web-assets /workspace/packages/frontend/dist /opt/onlyalpha/web
COPY database/postgres/migrations /opt/onlyalpha/schema
USER onlyalpha
# Exercise the final filesystem as its actual unprivileged runtime user.
# This build step needs no deployment, database, container, or business data.
RUN /opt/onlyalpha/algorithms/bin/python -B -I - <<'PY_RUNTIME_SMOKE'
import hashlib
import importlib.util
import json
import subprocess
from importlib.metadata import distribution, version
from pathlib import Path

import pyarrow
import onlyalpha_calculation_worker.chart_worker

root = Path("/opt/onlyalpha/algorithms")
manifest_bytes = (root / "algorithm-installation.json").read_bytes()
manifest = json.loads(manifest_bytes)
assert hashlib.sha256(manifest_bytes).hexdigest() == Path("/opt/onlyalpha/algorithm-artifact.sha256").read_text().strip()
assert version("onlyalpha") == manifest["distribution_version"]
for name in ("onlyalpha.application", "onlyalpha.runtime", "onlyalpha_http_server", "onlyalpha_agent_orchestrator"):
    assert importlib.util.find_spec(name) is None, name
for name in ("onlyalpha", "onlyalpha-calculation-worker", "onlyalpha-plugin-indicators", "onlyalpha-gateway-protocol"):
    assert not distribution(name).entry_points, name
for flag in ("--export-openapi", "--export-websocket"):
    result = subprocess.run(["/usr/local/bin/onlyalpha-backend", flag], env={}, check=True, stdout=subprocess.PIPE, timeout=30)
    assert isinstance(json.loads(result.stdout), dict), flag
PY_RUNTIME_SMOKE
ENTRYPOINT ["/usr/local/bin/onlyalpha-backend"]
CMD ["--user-data-root", "/var/lib/onlyalpha"]
