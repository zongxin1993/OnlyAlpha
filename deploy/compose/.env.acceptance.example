# Committed local-only credentials for destructive database acceptance.
ONLYALPHA_COMPOSE_PROJECT_NAME=onlyalpha-acceptance
ONLYALPHA_DATABASE_NETWORK=onlyalpha-acceptance

ONLYALPHA_POSTGRES_USER=onlyalpha
ONLYALPHA_POSTGRES_PASSWORD=onlyalpha_test
ONLYALPHA_POSTGRES_DATABASE=onlyalpha_test
ONLYALPHA_POSTGRES_VOLUME=onlyalpha-acceptance-postgres18-data

ONLYALPHA_CLICKHOUSE_USER=onlyalpha
ONLYALPHA_CLICKHOUSE_PASSWORD=onlyalpha_test
ONLYALPHA_CLICKHOUSE_DATABASE=default
ONLYALPHA_CLICKHOUSE_VOLUME=onlyalpha-acceptance-clickhouse-data
ONLYALPHA_CLICKHOUSE_HOT_VOLUME=onlyalpha-acceptance-clickhouse-hot
ONLYALPHA_CLICKHOUSE_COLD_VOLUME=onlyalpha-acceptance-clickhouse-cold
ONLYALPHA_OPERATOR_IMAGE=onlyalpha-acceptance:local
ONLYALPHA_ACCEPTANCE_IMAGE=onlyalpha-acceptance:local

# The canonical ONLYALPHA_POSTGRES_DSN is constructed only inside the acceptance
# container from these local-only values and private Compose DNS. No database
# port is published to the host.
