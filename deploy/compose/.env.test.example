# Committed local-only credentials for destructive P9.3 database acceptance.
ONLYALPHA_COMPOSE_PROJECT_NAME=onlyalpha-p93-test
ONLYALPHA_DATABASE_NETWORK=onlyalpha-p93-test

ONLYALPHA_POSTGRES_USER=onlyalpha
ONLYALPHA_POSTGRES_PASSWORD=onlyalpha_test
ONLYALPHA_POSTGRES_DATABASE=onlyalpha_test
ONLYALPHA_POSTGRES_VOLUME=onlyalpha-p93-test-postgres18-data

ONLYALPHA_CLICKHOUSE_USER=onlyalpha
ONLYALPHA_CLICKHOUSE_PASSWORD=onlyalpha_test
ONLYALPHA_CLICKHOUSE_DATABASE=default
ONLYALPHA_CLICKHOUSE_VOLUME=onlyalpha-p93-test-clickhouse-data
ONLYALPHA_CLICKHOUSE_HOT_VOLUME=onlyalpha-p93-test-clickhouse-hot
ONLYALPHA_CLICKHOUSE_COLD_VOLUME=onlyalpha-p93-test-clickhouse-cold
ONLYALPHA_ACCEPTANCE_IMAGE=onlyalpha-p93-acceptance:0.9.8

# DSNs are injected only into the acceptance container and use private Compose
# DNS. No database port is published to the host.
