# Copy to deploy/compose/.env, set real secrets, and chmod 600 before use.
ONLYALPHA_COMPOSE_PROJECT_NAME=onlyalpha
ONLYALPHA_DATABASE_NETWORK=onlyalpha
ONLYALPHA_OPERATOR_IMAGE=onlyalpha-operator:0.9.8
ONLYALPHA_USER_DATA_VOLUME=onlyalpha-user-data
ONLYALPHA_BACKUP_PATH=/srv/onlyalpha/backups
ONLYALPHA_PRODUCT_CONFIG_PATH=/srv/onlyalpha/product-config
ONLYALPHA_BINANCE_API_KEY=
ONLYALPHA_BINANCE_API_SECRET=
ONLYALPHA_HTTP_BIND_ADDRESS=127.0.0.1
ONLYALPHA_HTTP_PORT=8000

ONLYALPHA_POSTGRES_USER=onlyalpha
ONLYALPHA_POSTGRES_PASSWORD=change-me
ONLYALPHA_POSTGRES_DATABASE=onlyalpha
ONLYALPHA_POSTGRES_VOLUME=onlyalpha-postgres-data
ONLYALPHA_POSTGRES_DSN=postgresql://onlyalpha:<url-encoded-password>@onlyalpha-postgres:5432/onlyalpha

ONLYALPHA_CLICKHOUSE_USER=onlyalpha
ONLYALPHA_CLICKHOUSE_PASSWORD=change-me
ONLYALPHA_CLICKHOUSE_DATABASE=onlyalpha
ONLYALPHA_CLICKHOUSE_VOLUME=onlyalpha-clickhouse-data
ONLYALPHA_CLICKHOUSE_HOT_VOLUME=onlyalpha-clickhouse-hot
ONLYALPHA_CLICKHOUSE_COLD_VOLUME=onlyalpha-clickhouse-cold
ONLYALPHA_CLICKHOUSE_URL=http://onlyalpha-clickhouse:8123
ONLYALPHA_CLICKHOUSE_STORAGE_POLICY=hot_cold
