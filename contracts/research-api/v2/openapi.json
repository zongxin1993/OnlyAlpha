  "info": {
    "title": "OnlyAlpha Research Read API",
    "version": "2"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/research/artifacts/{research_result_fingerprint}": {
      "get": {
        "operationId": "artifact_summary_api_v2_research_artifacts__research_result_fingerprint__get",
        "parameters": [
          {
            "in": "path",
            "name": "research_result_fingerprint",
            "required": true,
            "schema": {
              "title": "Research Result Fingerprint",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchArtifactSummaryDto"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Invalid Research query"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Exact Artifact or Statistics identity not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Research Artifact verification failed"
          }
        },
        "summary": "Artifact Summary",
        "tags": [
          "research"
        ]
      }
    },
    "/api/v2/research/artifacts/{research_result_fingerprint}/statistics": {
      "get": {
        "operationId": "statistics_catalog_api_v2_research_artifacts__research_result_fingerprint__statistics_get",
        "parameters": [
          {
            "in": "path",
            "name": "research_result_fingerprint",
            "required": true,
            "schema": {
              "title": "Research Result Fingerprint",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchStatisticsCatalogDto"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Invalid Research query"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Exact Artifact or Statistics identity not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Research Artifact verification failed"
          }
        },
        "summary": "Statistics Catalog",
        "tags": [
          "research"
        ]
      }
    },
    "/api/v2/research/artifacts/{research_result_fingerprint}/statistics/{statistics_fingerprint}/series": {
      "get": {
        "operationId": "statistic_series_api_v2_research_artifacts__research_result_fingerprint__statistics__statistics_fingerprint__series_get",
        "parameters": [
          {
            "in": "path",
            "name": "research_result_fingerprint",
            "required": true,
            "schema": {
              "title": "Research Result Fingerprint",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "statistics_fingerprint",
            "required": true,
            "schema": {
              "title": "Statistics Fingerprint",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from_ts_event_ns",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(?:0|-?[1-9][0-9]*)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From Ts Event Ns"
            }
          },
          {
            "in": "query",
            "name": "to_ts_event_ns",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(?:0|-?[1-9][0-9]*)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To Ts Event Ns"
            }
          },
          {
            "in": "query",
            "name": "after_ts_event_ns",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(?:0|-?[1-9][0-9]*)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After Ts Event Ns"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 1000,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchStatisticSeriesPageDto"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Invalid Research query"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Exact Artifact or Statistics identity not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Research Artifact verification failed"
          }
        },
        "summary": "Statistic Series",
        "tags": [
          "research"
        ]
      }
    }
