                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Research Artifact verification failed"
          }
        },
        "summary": "Statistics Catalog",
        "tags": [
          "research"
        ]
      }
    },
    "/api/v2/research/artifacts/{research_result_fingerprint}/statistics/{statistics_fingerprint}/series": {
      "get": {
        "operationId": "statistic_series_api_v2_research_artifacts__research_result_fingerprint__statistics__statistics_fingerprint__series_get",
        "parameters": [
          {
            "in": "path",
            "name": "research_result_fingerprint",
            "required": true,
            "schema": {
              "title": "Research Result Fingerprint",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "statistics_fingerprint",
            "required": true,
            "schema": {
              "title": "Statistics Fingerprint",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from_ts_event_ns",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(?:0|-?[1-9][0-9]*)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From Ts Event Ns"
            }
          },
          {
            "in": "query",
            "name": "to_ts_event_ns",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(?:0|-?[1-9][0-9]*)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To Ts Event Ns"
            }
          },
          {
            "in": "query",
            "name": "after_ts_event_ns",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(?:0|-?[1-9][0-9]*)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After Ts Event Ns"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 1000,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchStatisticSeriesPageDto"
                }
