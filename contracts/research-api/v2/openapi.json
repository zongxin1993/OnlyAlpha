  "paths": {
    "/api/v2/research/artifacts/{research_result_fingerprint}": {
      "get": {
        "operationId": "artifact_summary_api_v2_research_artifacts__research_result_fingerprint__get",
        "parameters": [
          {
            "in": "path",
            "name": "research_result_fingerprint",
            "required": true,
            "schema": {
              "title": "Research Result Fingerprint",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchArtifactSummaryDto"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Invalid Research query"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Exact Artifact or Statistics identity not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchErrorDto"
                }
              }
            },
            "description": "Research Artifact verification failed"
          }
        },
        "summary": "Artifact Summary",
        "tags": [
          "research"
        ]
      }
    },
    "/api/v2/research/artifacts/{research_result_fingerprint}/statistics": {
      "get": {
        "operationId": "statistics_catalog_api_v2_research_artifacts__research_result_fingerprint__statistics_get",
        "parameters": [
          {
            "in": "path",
            "name": "research_result_fingerprint",
            "required": true,
            "schema": {
              "title": "Research Result Fingerprint",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
