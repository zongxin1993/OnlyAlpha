{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onlyalpha.product-api.v2.market-data-stream",
  "$defs": {
    "MarketDataBarSemanticDto": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "formation": {
          "discriminator": {
            "mapping": {
              "CALENDAR_PERIOD": "#/$defs/MarketDataCalendarPeriodFormationDto",
              "FIXED_DURATION": "#/$defs/MarketDataFixedDurationFormationDto",
              "TICK_COUNT": "#/$defs/MarketDataTickCountFormationDto",
              "VALUE": "#/$defs/MarketDataValueFormationDto",
              "VOLUME": "#/$defs/MarketDataVolumeFormationDto"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/MarketDataFixedDurationFormationDto"
            },
            {
              "$ref": "#/$defs/MarketDataCalendarPeriodFormationDto"
            },
            {
              "$ref": "#/$defs/MarketDataTickCountFormationDto"
            },
            {
              "$ref": "#/$defs/MarketDataVolumeFormationDto"
            },
            {
              "$ref": "#/$defs/MarketDataValueFormationDto"
            }
          ],
          "title": "Formation"
        },
        "price_type": {
          "enum": [
            "LAST",
            "BID",
            "ASK",
            "MID",
            "MARK",
            "INDEX"
          ],
          "title": "Price Type",
          "type": "string"
        },
        "adjustment_policy": {
          "enum": [
            "RAW",
            "FORWARD",
            "BACKWARD"
          ],
          "title": "Adjustment Policy",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "formation",
        "price_type",
        "adjustment_policy"
      ],
      "title": "MarketDataBarSemanticDto",
      "type": "object"
    },
    "MarketDataCalendarPeriodFormationDto": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "const": "CALENDAR_PERIOD",
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "enum": [
            "DAY",
            "WEEK",
            "MONTH"
          ],
          "title": "Unit",
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "alignment": {
          "enum": [
            "UTC",
            "SESSION_START"
          ],
          "title": "Alignment",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "unit",
        "count",
        "alignment"
      ],
      "title": "MarketDataCalendarPeriodFormationDto",
      "type": "object"
    },
    "MarketDataFixedDurationFormationDto": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "const": "FIXED_DURATION",
          "title": "Kind",
          "type": "string"
        },
        "window_minutes": {
          "maximum": 240,
          "minimum": 1,
          "title": "Window Minutes",
          "type": "integer"
        },
        "stride_minutes": {
          "maximum": 240,
          "minimum": 1,
          "title": "Stride Minutes",
          "type": "integer"
        },
        "alignment": {
          "enum": [
            "UTC",
            "SESSION_START"
          ],
          "title": "Alignment",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "window_minutes",
        "stride_minutes",
        "alignment"
      ],
      "title": "MarketDataFixedDurationFormationDto",
      "type": "object"
    },
    "MarketDataStreamSourceReferenceDto": {
      "additionalProperties": false,
      "properties": {
        "integration_id": {
          "minLength": 1,
          "title": "Integration Id",
          "type": "string"
        },
        "integration_revision_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Integration Revision Fingerprint",
          "type": "string"
        },
        "expected_type_id": {
          "minLength": 1,
          "title": "Expected Type Id",
          "type": "string"
        }
      },
      "required": [
        "integration_id",
        "integration_revision_fingerprint",
        "expected_type_id"
      ],
      "title": "MarketDataStreamSourceReferenceDto",
      "type": "object"
    },
    "MarketDataTickCountFormationDto": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "const": "TICK_COUNT",
          "title": "Kind",
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "count"
      ],
      "title": "MarketDataTickCountFormationDto",
      "type": "object"
    },
    "MarketDataValueFormationDto": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "const": "VALUE",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "value"
      ],
      "title": "MarketDataValueFormationDto",
      "type": "object"
    },
    "MarketDataVolumeFormationDto": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "const": "VOLUME",
          "title": "Kind",
          "type": "string"
        },
        "quantity": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "title": "Quantity",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "quantity"
      ],
      "title": "MarketDataVolumeFormationDto",
      "type": "object"
    },
    "MarketDataBarClosedDto": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "bar_semantic": {
          "$ref": "#/$defs/MarketDataBarSemanticDto"
        },
        "bar": {
          "$ref": "#/$defs/MarketDataBarDto"
        },
        "event": {
          "const": "BAR_CLOSED",
          "title": "Event",
          "type": "string"
        },
        "sequence": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "title": "Sequence",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "instrument_id",
        "bar_semantic",
        "bar",
        "event",
        "sequence"
      ],
      "title": "MarketDataBarClosedDto",
      "type": "object"
    },
    "MarketDataBarDto": {
      "additionalProperties": false,
      "properties": {
        "bar_start_ns": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "title": "Bar Start Ns",
          "type": "string"
        },
        "bar_end_ns": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "title": "Bar End Ns",
          "type": "string"
        },
        "open": {
          "title": "Open",
          "type": "string"
        },
        "high": {
          "title": "High",
          "type": "string"
        },
        "low": {
          "title": "Low",
          "type": "string"
        },
        "close": {
          "title": "Close",
          "type": "string"
        },
        "volume": {
          "title": "Volume",
          "type": "string"
        },
        "closed": {
          "title": "Closed",
          "type": "boolean"
        }
      },
      "required": [
        "bar_start_ns",
        "bar_end_ns",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "closed"
      ],
      "title": "MarketDataBarDto",
      "type": "object"
    },
    "MarketDataBarPreviewDto": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "bar_semantic": {
          "$ref": "#/$defs/MarketDataBarSemanticDto"
        },
        "bar": {
          "$ref": "#/$defs/MarketDataBarDto"
        },
        "event": {
          "const": "BAR_PREVIEW",
          "title": "Event",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "instrument_id",
        "bar_semantic",
        "bar",
        "event"
      ],
      "title": "MarketDataBarPreviewDto",
      "type": "object"
    },
    "MarketDataBaseCursorDto": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "event": {
          "const": "BASE_CURSOR",
          "title": "Event",
          "type": "string"
        },
        "sequence": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "title": "Sequence",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event",
        "sequence"
      ],
      "title": "MarketDataBaseCursorDto",
      "type": "object"
    },
    "MarketDataStateDto": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "event": {
          "const": "STATE",
          "title": "Event",
          "type": "string"
        },
        "state": {
          "enum": [
            "CONNECTING",
            "RECOVERING",
            "READY",
            "DEGRADED",
            "FAILED",
            "CLOSED"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event",
        "state"
      ],
      "title": "MarketDataStateDto",
      "type": "object"
    },
    "MarketDataStreamErrorDto": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "event": {
          "const": "ERROR",
          "title": "Event",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "schema_version",
        "event",
        "code"
      ],
      "title": "MarketDataStreamErrorDto",
      "type": "object"
    },
    "MarketDataSubscribedDto": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "event": {
          "const": "SUBSCRIBED",
          "title": "Event",
          "type": "string"
        },
        "stream_id": {
          "title": "Stream Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "resolution_mode": {
          "enum": [
            "PROVIDER_NATIVE",
            "DERIVED"
          ],
          "title": "Resolution Mode",
          "type": "string"
        },
        "resolution_plan_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resolution Plan Fingerprint",
          "type": "string"
        },
        "cursor_bar_stride_minutes": {
          "maximum": 240,
          "minimum": 1,
          "title": "Cursor Bar Stride Minutes",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "event",
        "stream_id",
        "source_id",
        "instrument_id",
        "resolution_mode",
        "resolution_plan_fingerprint",
        "cursor_bar_stride_minutes"
      ],
      "title": "MarketDataSubscribedDto",
      "type": "object"
    },
    "subscribe": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "operation": {
          "const": "SUBSCRIBE_BAR",
          "title": "Operation",
          "type": "string"
        },
        "source_reference": {
          "$ref": "#/$defs/MarketDataStreamSourceReferenceDto"
        },
        "instrument_id": {
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "bar_semantic": {
          "$ref": "#/$defs/MarketDataBarSemanticDto"
        },
        "resume_after_sequence": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "title": "Resume After Sequence",
          "type": "string"
        },
        "resume_plan_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resume Plan Fingerprint"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "source_reference",
        "instrument_id",
        "bar_semantic",
        "resume_after_sequence"
      ],
      "title": "MarketDataStreamSubscribeDto",
      "type": "object",
      "if": {
        "properties": {
          "resume_after_sequence": {
            "not": {
              "const": "0"
            }
          }
        }
      },
      "then": {
        "required": [
          "resume_plan_fingerprint"
        ],
        "properties": {
          "resume_plan_fingerprint": {
            "type": "string"
          }
        }
      }
    },
    "event": {
      "discriminator": {
        "mapping": {
          "BAR_CLOSED": "#/$defs/MarketDataBarClosedDto",
          "BAR_PREVIEW": "#/$defs/MarketDataBarPreviewDto",
          "BASE_CURSOR": "#/$defs/MarketDataBaseCursorDto",
          "ERROR": "#/$defs/MarketDataStreamErrorDto",
          "STATE": "#/$defs/MarketDataStateDto",
          "SUBSCRIBED": "#/$defs/MarketDataSubscribedDto"
        },
        "propertyName": "event"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MarketDataSubscribedDto"
        },
        {
          "$ref": "#/$defs/MarketDataStateDto"
        },
        {
          "$ref": "#/$defs/MarketDataBaseCursorDto"
        },
        {
          "$ref": "#/$defs/MarketDataBarPreviewDto"
        },
        {
          "$ref": "#/$defs/MarketDataBarClosedDto"
        },
        {
          "$ref": "#/$defs/MarketDataStreamErrorDto"
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/subscribe"
    },
    {
      "$ref": "#/$defs/event"
    }
  ]
}
