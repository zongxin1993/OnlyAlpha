{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onlyalpha.product-api.v2.market-data-stream",
  "$defs": {
    "MarketDataSubscribedDto": {
      "additionalProperties": false,
      "properties": {
        "cursor_bar_stride_minutes": {
          "format": "int64",
          "maximum": 240,
          "minimum": 1,
          "type": "integer"
        },
        "event": {
          "$ref": "#/$defs/MarketDataSubscribedDtoEvent"
        },
        "instrument_id": {
          "type": "string"
        },
        "resolution_mode": {
          "$ref": "#/$defs/MarketDataSubscribedDtoResolutionMode"
        },
        "resolution_plan_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/Version2"
        },
        "source_id": {
          "type": "string"
        },
        "stream_id": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event",
        "stream_id",
        "source_id",
        "instrument_id",
        "resolution_mode",
        "resolution_plan_fingerprint",
        "cursor_bar_stride_minutes"
      ],
      "type": "object"
    },
    "MarketDataSubscribedDtoEvent": {
      "enum": [
        "SUBSCRIBED"
      ],
      "type": "string"
    },
    "MarketDataSubscribedDtoResolutionMode": {
      "enum": [
        "PROVIDER_NATIVE",
        "DERIVED"
      ],
      "type": "string"
    },
    "Version2": {
      "enum": [
        2
      ],
      "type": "integer"
    },
    "MarketDataStateDto": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/MarketDataStateDtoEvent"
        },
        "schema_version": {
          "$ref": "#/$defs/Version2"
        },
        "state": {
          "$ref": "#/$defs/MarketDataStateDtoState"
        }
      },
      "required": [
        "schema_version",
        "event",
        "state"
      ],
      "type": "object"
    },
    "MarketDataStateDtoEvent": {
      "enum": [
        "STATE"
      ],
      "type": "string"
    },
    "MarketDataStateDtoState": {
      "enum": [
        "CONNECTING",
        "RECOVERING",
        "READY",
        "DEGRADED",
        "FAILED",
        "CLOSED"
      ],
      "type": "string"
    },
    "MarketDataBaseCursorDto": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/MarketDataBaseCursorDtoEvent"
        },
        "schema_version": {
          "$ref": "#/$defs/Version2"
        },
        "sequence": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event",
        "sequence"
      ],
      "type": "object"
    },
    "MarketDataBaseCursorDtoEvent": {
      "enum": [
        "BASE_CURSOR"
      ],
      "type": "string"
    },
    "MarketDataBarPreviewDto": {
      "additionalProperties": false,
      "properties": {
        "bar": {
          "$ref": "#/$defs/MarketDataBarDto"
        },
        "bar_semantic": {
          "$ref": "#/$defs/MarketDataBarSemanticDto"
        },
        "event": {
          "$ref": "#/$defs/MarketDataBarPreviewDtoEvent"
        },
        "instrument_id": {
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/Version2"
        },
        "source_id": {
          "type": "string"
        },
        "timing": {
          "oneOf": [
            {
              "$ref": "#/$defs/MarketDataIngressTimingDto"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "instrument_id",
        "bar_semantic",
        "bar",
        "timing",
        "event"
      ],
      "type": "object"
    },
    "MarketDataBarDto": {
      "additionalProperties": false,
      "properties": {
        "bar_end_ns": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "type": "string"
        },
        "bar_start_ns": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "type": "string"
        },
        "close": {
          "type": "string"
        },
        "closed": {
          "type": "boolean"
        },
        "high": {
          "type": "string"
        },
        "low": {
          "type": "string"
        },
        "open": {
          "type": "string"
        },
        "volume": {
          "type": "string"
        }
      },
      "required": [
        "bar_end_ns",
        "bar_start_ns",
        "close",
        "closed",
        "high",
        "low",
        "open",
        "volume"
      ],
      "type": "object"
    },
    "MarketDataBarSemanticDto": {
      "additionalProperties": false,
      "properties": {
        "adjustment_policy": {
          "$ref": "#/$defs/MarketDataBarSemanticDtoAdjustmentPolicy"
        },
        "formation": {
          "$ref": "#/$defs/MarketDataBarSemanticDtoFormation"
        },
        "price_type": {
          "$ref": "#/$defs/OnlyPriceType"
        },
        "schema_version": {
          "$ref": "#/$defs/Version3"
        }
      },
      "required": [
        "adjustment_policy",
        "formation",
        "price_type",
        "schema_version"
      ],
      "type": "object"
    },
    "MarketDataBarSemanticDtoAdjustmentPolicy": {
      "enum": [
        "RAW",
        "FORWARD",
        "BACKWARD"
      ],
      "type": "string"
    },
    "MarketDataBarSemanticDtoFormation": {
      "oneOf": [
        {
          "$ref": "#/$defs/MarketDataFixedDurationFormationDto"
        },
        {
          "$ref": "#/$defs/MarketDataCalendarPeriodFormationDto"
        },
        {
          "$ref": "#/$defs/MarketDataTickCountFormationDto"
        },
        {
          "$ref": "#/$defs/MarketDataVolumeFormationDto"
        },
        {
          "$ref": "#/$defs/MarketDataValueFormationDto"
        }
      ]
    },
    "MarketDataFixedDurationFormationDto": {
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "$ref": "#/$defs/MarketDataFixedDurationFormationDtoAlignment"
        },
        "kind": {
          "$ref": "#/$defs/MarketDataFixedDurationFormationDtoKind"
        },
        "schema_version": {
          "$ref": "#/$defs/Version1"
        },
        "stride_minutes": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "window_minutes": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "alignment",
        "kind",
        "schema_version",
        "stride_minutes",
        "window_minutes"
      ],
      "type": "object"
    },
    "MarketDataFixedDurationFormationDtoAlignment": {
      "enum": [
        "UTC",
        "SESSION_START"
      ],
      "type": "string"
    },
    "MarketDataFixedDurationFormationDtoKind": {
      "enum": [
        "FIXED_DURATION"
      ],
      "type": "string"
    },
    "Version1": {
      "enum": [
        1
      ],
      "type": "integer"
    },
    "MarketDataCalendarPeriodFormationDto": {
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "$ref": "#/$defs/MarketDataCalendarPeriodFormationDtoAlignment"
        },
        "count": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/MarketDataCalendarPeriodFormationDtoKind"
        },
        "schema_version": {
          "$ref": "#/$defs/Version1"
        },
        "unit": {
          "$ref": "#/$defs/MarketDataCalendarPeriodFormationDtoUnit"
        }
      },
      "required": [
        "alignment",
        "count",
        "kind",
        "schema_version",
        "unit"
      ],
      "type": "object"
    },
    "MarketDataCalendarPeriodFormationDtoAlignment": {
      "enum": [
        "UTC",
        "SESSION_START"
      ],
      "type": "string"
    },
    "MarketDataCalendarPeriodFormationDtoKind": {
      "enum": [
        "CALENDAR_PERIOD"
      ],
      "type": "string"
    },
    "MarketDataCalendarPeriodFormationDtoUnit": {
      "enum": [
        "DAY",
        "WEEK",
        "MONTH"
      ],
      "type": "string"
    },
    "MarketDataTickCountFormationDto": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/MarketDataTickCountFormationDtoKind"
        },
        "schema_version": {
          "$ref": "#/$defs/Version1"
        }
      },
      "required": [
        "count",
        "kind",
        "schema_version"
      ],
      "type": "object"
    },
    "MarketDataTickCountFormationDtoKind": {
      "enum": [
        "TICK_COUNT"
      ],
      "type": "string"
    },
    "MarketDataVolumeFormationDto": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/MarketDataVolumeFormationDtoKind"
        },
        "quantity": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/Version2"
        }
      },
      "required": [
        "kind",
        "quantity",
        "schema_version"
      ],
      "type": "object"
    },
    "MarketDataVolumeFormationDtoKind": {
      "enum": [
        "VOLUME"
      ],
      "type": "string"
    },
    "MarketDataValueFormationDto": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/MarketDataValueFormationDtoKind"
        },
        "schema_version": {
          "$ref": "#/$defs/Version2"
        },
        "value": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "value"
      ],
      "type": "object"
    },
    "MarketDataValueFormationDtoKind": {
      "enum": [
        "VALUE"
      ],
      "type": "string"
    },
    "OnlyPriceType": {
      "enum": [
        "LAST",
        "BID",
        "ASK",
        "MID",
        "MARK"
      ],
      "type": "string"
    },
    "Version3": {
      "enum": [
        3
      ],
      "type": "integer"
    },
    "MarketDataBarPreviewDtoEvent": {
      "enum": [
        "BAR_PREVIEW"
      ],
      "type": "string"
    },
    "MarketDataIngressTimingDto": {
      "additionalProperties": false,
      "properties": {
        "ingress_received_ns": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_event_ns": {
          "type": [
            "string",
            "null"
          ]
        },
        "stream_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "stream_id",
        "provider_event_ns",
        "ingress_received_ns"
      ],
      "type": "object"
    },
    "MarketDataBarClosedDto": {
      "additionalProperties": false,
      "properties": {
        "bar": {
          "$ref": "#/$defs/MarketDataBarDto"
        },
        "bar_semantic": {
          "$ref": "#/$defs/MarketDataBarSemanticDto"
        },
        "event": {
          "$ref": "#/$defs/MarketDataBarClosedDtoEvent"
        },
        "instrument_id": {
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/Version2"
        },
        "sequence": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "timing": {
          "oneOf": [
            {
              "$ref": "#/$defs/MarketDataIngressTimingDto"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "instrument_id",
        "bar_semantic",
        "bar",
        "timing",
        "event",
        "sequence"
      ],
      "type": "object"
    },
    "MarketDataBarClosedDtoEvent": {
      "enum": [
        "BAR_CLOSED"
      ],
      "type": "string"
    },
    "MarketDataStreamErrorDto": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "$ref": "#/$defs/MarketDataStreamErrorDtoEvent"
        },
        "schema_version": {
          "$ref": "#/$defs/Version2"
        }
      },
      "required": [
        "schema_version",
        "event",
        "code"
      ],
      "type": "object"
    },
    "MarketDataStreamErrorDtoEvent": {
      "enum": [
        "ERROR"
      ],
      "type": "string"
    },
    "StreamSubscribeOperation": {
      "enum": [
        "SUBSCRIBE_BAR"
      ],
      "type": "string"
    },
    "MarketDataStreamSourceReferenceDto": {
      "additionalProperties": false,
      "properties": {
        "expected_type_id": {
          "minLength": 1,
          "type": "string"
        },
        "integration_id": {
          "minLength": 1,
          "type": "string"
        },
        "integration_revision_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "integration_id",
        "integration_revision_fingerprint",
        "expected_type_id"
      ],
      "type": "object"
    },
    "TemporarySubscribedDto": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/TemporaryMarketDataAuthority"
        },
        "cursor_bar_stride_minutes": {
          "format": "int32",
          "maximum": 240,
          "minimum": 1,
          "type": "integer"
        },
        "event": {
          "$ref": "#/$defs/MarketDataSubscribedDtoEvent"
        },
        "instrument_id": {
          "type": "string"
        },
        "publication_status": {
          "$ref": "#/$defs/TemporaryMarketDataPublication"
        },
        "resolution_mode": {
          "$ref": "#/$defs/MarketDataSubscribedDtoResolutionMode"
        },
        "resolution_plan_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/Version2"
        },
        "source_id": {
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/TemporaryMarketDataSourceKind"
        },
        "stream_id": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event",
        "source_kind",
        "authority",
        "publication_status",
        "stream_id",
        "source_id",
        "instrument_id",
        "resolution_mode",
        "resolution_plan_fingerprint",
        "cursor_bar_stride_minutes"
      ],
      "type": "object"
    },
    "TemporaryMarketDataAuthority": {
      "enum": [
        "DISPLAY_ONLY"
      ],
      "type": "string"
    },
    "TemporaryMarketDataPublication": {
      "enum": [
        "NOT_A_RESEARCH_RESULT"
      ],
      "type": "string"
    },
    "TemporaryMarketDataSourceKind": {
      "enum": [
        "TEMPORARY_MARKET_DATA"
      ],
      "type": "string"
    },
    "TemporarySubscribeOperation": {
      "enum": [
        "SUBSCRIBE_TEMPORARY_BARS"
      ],
      "type": "string"
    },
    "subscribe": {
      "additionalProperties": false,
      "properties": {
        "bar_semantic": {
          "$ref": "#/$defs/MarketDataBarSemanticDto"
        },
        "instrument_id": {
          "minLength": 1,
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/StreamSubscribeOperation"
        },
        "resume_after_sequence": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "type": "string"
        },
        "resume_plan_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/Version2"
        },
        "source_reference": {
          "$ref": "#/$defs/MarketDataStreamSourceReferenceDto"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "source_reference",
        "instrument_id",
        "bar_semantic",
        "resume_after_sequence"
      ],
      "type": "object",
      "if": {
        "properties": {
          "resume_after_sequence": {
            "not": {
              "const": "0"
            }
          }
        }
      },
      "then": {
        "required": [
          "resume_plan_fingerprint"
        ],
        "properties": {
          "resume_plan_fingerprint": {
            "type": "string"
          }
        }
      }
    },
    "event": {
      "oneOf": [
        {
          "$ref": "#/$defs/MarketDataSubscribedDto"
        },
        {
          "$ref": "#/$defs/MarketDataStateDto"
        },
        {
          "$ref": "#/$defs/MarketDataBaseCursorDto"
        },
        {
          "$ref": "#/$defs/MarketDataBarPreviewDto"
        },
        {
          "$ref": "#/$defs/MarketDataBarClosedDto"
        },
        {
          "$ref": "#/$defs/MarketDataStreamErrorDto"
        }
      ]
    },
    "temporary_subscribe": {
      "additionalProperties": false,
      "properties": {
        "bar_semantic": {
          "$ref": "#/$defs/MarketDataBarSemanticDto"
        },
        "before_ns": {
          "pattern": "^(?:0|[1-9][0-9]*)$",
          "type": "string"
        },
        "expected_window_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "instrument_id": {
          "minLength": 1,
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/TemporarySubscribeOperation"
        },
        "page_id": {
          "format": "uuid",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/Version2"
        },
        "source_reference": {
          "$ref": "#/$defs/MarketDataStreamSourceReferenceDto"
        },
        "target_bar_count": {
          "format": "int32",
          "maximum": 2000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "page_id",
        "source_reference",
        "instrument_id",
        "bar_semantic",
        "before_ns",
        "target_bar_count",
        "expected_window_fingerprint"
      ],
      "type": "object"
    },
    "temporary_event": {
      "oneOf": [
        {
          "$ref": "#/$defs/TemporarySubscribedDto"
        },
        {
          "$ref": "#/$defs/MarketDataStateDto"
        },
        {
          "$ref": "#/$defs/MarketDataBarPreviewDto"
        },
        {
          "$ref": "#/$defs/MarketDataBarClosedDto"
        },
        {
          "$ref": "#/$defs/MarketDataStreamErrorDto"
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/subscribe"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/temporary_subscribe"
    },
    {
      "$ref": "#/$defs/temporary_event"
    }
  ]
}
