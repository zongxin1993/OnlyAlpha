{
  "factor_set": "onlyalpha.alpha101",
  "factor_set_version": "1",
  "name": "ALPHA100",
  "expression": "-((1.5 * CSScale(GroupDemean(GroupDemean(Rank((($close - $low) - ($high - $close)) / ($high - $low) * $volume), $subindustry_inner), $subindustry_outer)) - CSScale(GroupDemean(Corr($close, Rank(Mean($dollar_volume, 20)), 5) - Rank(IdxMin($close, 30)), $subindustry_correlation))) * ($volume / Mean($dollar_volume, 20)))"
}
