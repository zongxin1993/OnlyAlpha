  "interpretations": [
    {
      "name": "Alpha7",
      "source_ambiguity": "原文在窗口位置使用同时表示逐点极值的 MAX 或 MIN，需确定该位置取滚动极值还是逐点极值。",
      "interpretation": "参考实现将与正整数窗口组合的价格或指标极值解释为时序极值；同一公式中按行比较两个量的极值仍为逐点运算。"
    },
    {
      "name": "Alpha10",
      "source_ambiguity": "原式 MAX 和 RANK 的参数及窗口 5 的归属有歧义。",
      "interpretation": "先对负收益时的20日标准差或其余情况下的收盘价平方，再取5日时序最大值，最后做截面排名。"
    },
    {
      "name": "Alpha17",
      "source_ambiguity": "原文在窗口位置使用同时表示逐点极值的 MAX 或 MIN，需确定该位置取滚动极值还是逐点极值。",
      "interpretation": "参考实现将与正整数窗口组合的价格或指标极值解释为时序极值；同一公式中按行比较两个量的极值仍为逐点运算。"
    },
    {
      "name": "Alpha22",
      "source_ambiguity": "原文 SMEAN 未在附录中定义，其数值与初始化规则待确定。",
      "interpretation": "SMEAN 按 SMA(x,12,1) 解释。"
    },
    {
      "name": "Alpha28",
      "source_ambiguity": "原文在窗口位置使用同时表示逐点极值的 MAX 或 MIN，需确定该位置取滚动极值还是逐点极值。",
      "interpretation": "参考实现将与正整数窗口组合的价格或指标极值解释为时序极值；同一公式中按行比较两个量的极值仍为逐点运算。"
    },
    {
      "name": "Alpha30",
      "source_ambiguity": "三因子滚动回归的截距、退化样本处理及因子数据绑定待确定。",
      "interpretation": "以60个完整日期拟合含截距和三条解释变量的回归，取最后一行的残差。平方后按20日 0.9 的日龄幂归一化加权。"
    },
    {
      "name": "Alpha36",
      "source_ambiguity": "原文 CORR 缺窗口，SUM 与 RANK 的括号使窗口 6 和 2 的归属不明确。",
      "interpretation": "取两个截面排名的6日相关，进行2日求和，再做截面排名。"
    },
    {
      "name": "Alpha41",
      "source_ambiguity": "原文在窗口位置使用同时表示逐点极值的 MAX 或 MIN，需确定该位置取滚动极值还是逐点极值。",
      "interpretation": "参考实现将与正整数窗口组合的价格或指标极值解释为时序极值；同一公式中按行比较两个量的极值仍为逐点运算。"
    },
    {
      "name": "Alpha54",
      "source_ambiguity": "原文 STD 缺少窗口。",
      "interpretation": "STD(ABS(CLOSE-OPEN)) 的窗口取10日。"
    },
    {
      "name": "Alpha64",
